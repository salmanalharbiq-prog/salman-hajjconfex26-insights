القسم 10: المخطط البرمجي القياسي للحركة والتصميم (Implementation Blueprint)
التزم في كتابة الكود بالأنماط الهندسية القياسية التالية لضمان سرعة استجابة أقل من 300 مللي ثانية (Sub-300ms Micro-Interactions) ومعدل 60 إطاراً في الثانية:

1. قواعد CSS القياسية لـ (@property Aurora، Bento Grid، RTL Sliding Pill، SVG Arc Gauges، و Popover Drawer):
CSS
@property --aurora-angle { syntax: "<angle>"; inherits: false; initial-value: 135deg; }
@property --aurora-c1    { syntax: "<color>"; inherits: true;  initial-value: #064e3b; }
@property --aurora-c2    { syntax: "<color>"; inherits: true;  initial-value: #0f172a; }

:root {
  --bg-deep: #060913;
  --card-bg: rgba(15, 23, 42, 0.74);
  --card-border: rgba(255, 255, 255, 0.09);
  --text-primary: #f8fafc;
  --text-muted: #94a3b8;
  --accent-emerald: #10b981;
  --accent-gold: #d4af37;
  --accent-cyan: #06b6d4;
  --accent-orange: #f97316;
  --accent-crimson: #ef4444;
  --spotlight-color: rgba(212, 175, 55, 0.15);
  --card-radius: 20px;
  --card-padding: 14px;
  --inner-radius: calc(var(--card-radius) - var(--card-padding) + 2px);
  --ease-out-fast: cubic-bezier(0.22, 1, 0.36, 1);
  --ease-spring: cubic-bezier(0.45, 1.4, 0.5, 1);
}

.kpi-number, .kpi-delta, .node-metric, .delta-val, .metric-pill strong {
  font-variant-numeric: tabular-nums;
}

.bento-card {
  position: relative;
  background: var(--card-bg);
  border: 1px solid var(--card-border);
  border-radius: var(--card-radius);
  padding: var(--card-padding);
  backdrop-filter: blur(16px);
  overflow: hidden;
  transition: border-color 0.25s var(--ease-out-fast), box-shadow 0.25s var(--ease-out-fast);
}

.bento-card::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: radial-gradient(300px circle at var(--mouse-x, -9999px) var(--mouse-y, -9999px), var(--spotlight-color), transparent 80%);
  opacity: 0;
  transition: opacity 0.25s ease;
}
.bento-cockpit:hover .bento-card::before { opacity: 1; }

/* مؤشر الكبسولة المنزلق المتوافق مع العربية (RTL Negative X Translation) */
.segmented-track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
  background: rgba(0, 0, 0, 0.35);
  padding: 4px;
  border-radius: var(--inner-radius);
}
.segmented-track:has(label:nth-of-type(1) input:checked) { --active-index: 0; }
.segmented-track:has(label:nth-of-type(2) input:checked) { --active-index: 1; }
.segmented-track:has(label:nth-of-type(3) input:checked) { --active-index: 2; }
.segmented-track:has(label:nth-of-type(4) input:checked) { --active-index: 3; }

.sliding-pill {
  position: absolute;
  inset-block: 4px;
  inset-inline-start: 4px;
  inline-size: calc((100% - 8px) / var(--n, 4));
  background: rgba(212, 175, 55, 0.18);
  border: 1px solid rgba(212, 175, 55, 0.42);
  border-radius: calc(var(--inner-radius) - 2px);
  transform: translateX(calc(-100% * var(--active-index, 0)));
  transition: transform 0.26s var(--ease-spring);
}

/* العدادات القوسية المعيارية (SVG pathLength="100") */
.arc-track { fill: none; stroke: rgba(255, 255, 255, 0.08); stroke-width: 8; }
.arc-fill {
  fill: none;
  stroke: var(--gauge-color, var(--accent-emerald));
  stroke-width: 8;
  stroke-dasharray: 100;
  stroke-dashoffset: calc(100 - var(--val, 50));
  transition: stroke-dashoffset 0.28s var(--ease-out-fast), stroke 0.28s ease;
}

/* إعدادات View Transitions API دون تجميد النقرات */
::view-transition { pointer-events: none; }
::view-transition-old(root) { display: none; }
::view-transition-new(root) { animation: none; }
